// Pin: a return from inside a match arm must release the enclosing match
// statement's expression temporaries (the "zero" literal is allocated
// unconditionally at match entry and normally released at match end).
high program(): i32 {
  function f(x: i32): i32 {
    match x {
      0 => print("zero"),
      _ => { return 9 }
    }
    return 0
  }
  print(f(5))
  print(f(0))
  return 0
}
