high program(): i32 {
  function divide(a: i32, b: i32): i32? {
    if (b ?= 0) {
      return unknown("division by zero")
    }
    return a / b
  }

  let r1 = divide(10, 2)
  if (r1 is unknown) {
    print("first failed")
  } else {
    print(r1)
  }

  let r2 = divide(10, 0)
  if (r2 is unknown) {
    print(f"second failed: {r2.reason}")
  } else {
    print(r2)
  }

  return 0
}