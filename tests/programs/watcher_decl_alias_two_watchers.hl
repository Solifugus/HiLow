high program(args: [string]): i32 {
    let xs = [1]
    let ys = xs
    watcher wa((v=added)xs) {
        print("A:")
        print(v)
    }
    watcher wb((v=added)ys) {
        print("B:")
        print(v)
    }
    xs.push(2)
    xs = [10]
    ys.push(3)
    xs.push(4)
    print("done")
    return 0
}
