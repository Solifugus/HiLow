// Phase 6b: produces a burst after the consumer signals ready, then completes
// normally regardless of whether the consumer is still alive.
high program(): i32 {
    shared("XSEG_c") let c: i32 = 0
    shared("XSEG_r") let ready: i32 = 0
    while (ready < 1) { }
    let i = 1
    while (i <= 50) { c = i; i += 1 }
    print("producer done")
    return 0
}
